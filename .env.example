# --- Supabase (pubbliche: vanno bene anche nel browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://efldhensgxzvgawgxzwz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Solo server (MAI nel browser) ---
# Service role key: serve alle API REST (/api/v1) e alla sincronizzazione portali.
SUPABASE_SERVICE_ROLE_KEY=
# Chiave che i sistemi esterni devono passare come "Authorization: Bearer ..." alle API /api/v1
API_KEY=
# Vercel la imposta da solo quando esiste: protegge il cron di sincronizzazione
CRON_SECRET=

# --- Sito ---
NEXT_PUBLIC_SITE_URL=https://www.studioarteimmobiliare.com

# --- Notifiche email delle richieste (facoltativo, via Resend) ---
RESEND_API_KEY=
RESEND_FROM="Studio Arte Immobiliare <sito@studioarteimmobiliare.com>"
NOTIFY_EMAIL=info@studioarteimmobiliare.com

# --- Immobiliare.it (forniti dal loro supporto all'attivazione dell'integrazione) ---
IMMOBILIARE_AGENCY_EMAIL=info@studioarteimmobiliare.com
# Modalita' REST (consigliata da Immobiliare):
IMMOBILIARE_REST_URL=https://feed.immobiliare.it/ws/import/immobiliare
IMMOBILIARE_REST_USER=
IMMOBILIARE_REST_PASSWORD=
IMMOBILIARE_SOURCE=
# Modalita' batch FTP (alternativa):
IMMOBILIARE_FTP_HOST=
IMMOBILIARE_FTP_USER=
IMMOBILIARE_FTP_PASSWORD=
IMMOBILIARE_FTP_PATH=/

# --- idealista (forniti dal loro team integrazioni) ---
IDEALISTA_API_URL=
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
IDEALISTA_AGENCY_ID=

# Token facoltativo per proteggere i feed pubblici (/api/feed/*.xml?token=...)
FEED_TOKEN=
